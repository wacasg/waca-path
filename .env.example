# WACA path local configuration example
# Copy this file to .env and replace placeholders with your own values.
# Do not commit .env.

# PORT and LOG_LEVEL are not read by the FastAPI app itself.
# PORT is only a hint for how you start the server: pass it to uvicorn
# (`uvicorn main:app --port "$PORT"`), or rely on Cloud Run's injected $PORT.
# LOG_LEVEL is reserved for future use and is not applied by the minimal backend.
PORT=8080
LOG_LEVEL=INFO

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-or-adc.json
WACA_CORE_DATASET=waca_core_output
WACA_PATH_LOCATION=asia-northeast1

SAMPLE_WACA_CORE_DATASET=waca_path_sample_core
DEFAULT_TENANT_ID=example

# --- Admin UI (v0.2.0) ---
# The UI reads the same dataset as the site-audit endpoint; no extra variables
# are required. The language is negotiated per request (?lang=, cookie,
# Accept-Language, then tenant_config `ui.default_lang`).

# --- Optional AI summary (v0.4.0) ---
# Everything in WACA path works with these unset. Set BOTH a provider and its
# key to enable the "Summarize with AI" button on the journey page and
# POST /api/users/{id}/journey/summary; otherwise the endpoint answers 409 and
# the button is not rendered. Install the SDK first:
#   pip install -r backend/requirements-ai.txt
# Each call sends the journey digest (page paths, timestamps, event names) to
# the provider and costs money; there is a per-process cap of 10 calls/minute.
#WACA_PATH_AI_PROVIDER=anthropic          # anthropic | openai | google
#ANTHROPIC_API_KEY=                       # used when provider=anthropic
#OPENAI_API_KEY=                          # used when provider=openai
#GOOGLE_API_KEY=                          # used when provider=google
#WACA_PATH_AI_MODEL=                      # default: claude-sonnet-4-6 / gpt-5-mini / gemini-2.5-flash
#WACA_PATH_AI_RATE_LIMIT_PER_MIN=10
#WACA_PATH_AI_MAX_TOKENS=1200
